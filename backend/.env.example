# AI Provider: "ollama" (kostenlos, lokal) oder "claude" (API Key nötig)
AI_PROVIDER=ollama

# Claude API Key (nur wenn AI_PROVIDER=claude)
# Hol dir einen auf: https://console.anthropic.com/
ANTHROPIC_API_KEY=dummy-key

# Ollama Settings (nur wenn AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# Datenbank
DATABASE_URL=sqlite:///./data/assistant.db

# Server
HOST=0.0.0.0
PORT=8000
